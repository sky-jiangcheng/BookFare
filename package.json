{
  "name": "book-ferry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test": "npm run test:unit",
    "test:unit": "node --require ./scripts/preload.cjs --import tsx --test tests/*.test.ts tests/minor-issues-regression.test.mjs tests/no-vector-architecture.test.mjs tests/remaining-significant-issues.test.mjs tests/significant-issues-regression.test.mjs tests/type-migration-regression.test.mjs",
    "import:books": "node ./scripts/import-books.mjs",
    "migrate:publication-year": "node ./scripts/migrate-publication-year.mjs",
    "backfill:publication-years": "node ./scripts/backfill-publication-years.mjs",
    "smoke:rag": "node ./scripts/smoke-rag.mjs",
    "vercel:build": "next build",
    "vercel:deploy": "vercel --prod"
  },
  "dependencies": {
